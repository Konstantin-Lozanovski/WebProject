# Copy this file to .env and fill in the values.
# Every setting is optional when running locally or in Docker.

# Port the backend listens on (default 5000)
PORT=

# MongoDB connection string. Leave empty to use the local database.
# In the cloud this is set to the MongoDB Atlas address.
MONGO_URI=

# Key that signs the login tokens. Leave empty locally and in Docker.
# In the cloud this must be set to a long random text.
JWT_SECRET=

# Mail provider (Brevo, over SMTP). Leave all of them empty locally and in
# Docker: every email is then written to the server log instead of being sent.
# In the cloud they are set in Render's dashboard, never in the repo.
# MAIL_FROM is the sender address verified at the provider.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
