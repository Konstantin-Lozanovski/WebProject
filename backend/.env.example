# Copy this file to .env and fill in the values.
# Both settings are optional when running locally or in Docker.

# Port the backend listens on (default 5000)
PORT=

# MongoDB connection string. Leave empty to use the local database.
# In the cloud this is set to the MongoDB Atlas address.
MONGO_URI=

# Key that signs the login tokens. Leave empty locally and in Docker.
# In the cloud this must be set to a long random text.
JWT_SECRET=
